# Salin ke .env lalu isi. File .env TIDAK boleh masuk git — di Jenkins,
# distribusikan lewat Credentials (secret file) atau taruh permanen di server.

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bankqc
POSTGRES_USER=bankqc
POSTGRES_PASSWORD=changeme

# Redis (port 6378 — sama dengan `redis-server --port 6378` di docker-compose)
REDIS_URL=redis://redis:6378/0

# MinIO
MINIO_ENDPOINT=minio:4003
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme123
MINIO_BUCKET_TRANSCRIPTS=transcripts
MINIO_BUCKET_RESULTS=results
MINIO_BUCKET_CAMPAIGNS=campaigns
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_AUDIO=audio
MINIO_BUCKET_SALES_DATABASE=sales-database
# MINIO_BUCKET_QC_DATABASE=qc-database

# Deployment lewat CDN: endpoint https + kredensial per-bucket (menggantikan
# MINIO_ACCESS_KEY/MINIO_SECRET_KEY global di atas — comment yang global kalau
# blok ini dipakai). Selama semua kosong, aplikasi tetap memakai key global.
# MINIO_ENDPOINT=cdn.bankmega.local
# MINIO_SECURE=true
# MINIO_ACCESS_KEY_TRANSCRIPTS=
# MINIO_SECRET_KEY_TRANSCRIPTS=
# MINIO_ACCESS_KEY_RESULTS=
# MINIO_SECRET_KEY_RESULTS=
# MINIO_ACCESS_KEY_CAMPAIGNS=
# MINIO_SECRET_KEY_CAMPAIGNS=
# MINIO_ACCESS_KEY_DOCUMENTS=
# MINIO_SECRET_KEY_DOCUMENTS=
# MINIO_ACCESS_KEY_AUDIO=
# MINIO_SECRET_KEY_AUDIO=
# MINIO_ACCESS_KEY_SALES_DATABASE=
# MINIO_SECRET_KEY_SALES_DATABASE=
# MINIO_ACCESS_KEY_QC_DATABASE=
# MINIO_SECRET_KEY_QC_DATABASE=
# Webhook ingestion (/webhook/process_ticket): where the upstream phase-1 caller
# drops the raw session PDFs inside the buckets above. "" = scan the whole bucket.
# Objects already under a {result_id} (UUID) folder are skipped.
MINIO_TRANSCRIPTS_SOURCE_PREFIX=inbox/
MINIO_DOCUMENTS_SOURCE_PREFIX=inbox/

# DWH API (Aplikasi A) — sumber reference data
DWH_API_BASE_URL=http://host.docker.internal:8002
DWH_API_TIMEOUT_SEC=10
DWH_API_CACHE_TTL_SEC=5

# LLM — endpoint OpenAI-compatible.
#   - self-hosted       : http://host.docker.internal:11444/v1  (model: gpt-oss-120b)
#   - Azure AI Foundry  : https://<your-foundry>.services.ai.azure.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=1800
LLM_TEMPERATURE=1.0
LLM_SEED=42
LLM_REASONING_EFFORT=medium

# RIPLAY extraction saat upload campaign (compliance/riplay.py).
# PDF dirender jadi image lalu dikirim ke model vision.
# RIPLAY_MODEL kosong = ikut LLM_MODEL.
# RIPLAY_MIN_SIMILARITY = ambang kemiripan nama produk di RIPLAY vs nama campaign.
RIPLAY_MODEL=
RIPLAY_MAX_PAGES=20
RIPLAY_RENDER_SCALE=2.0
RIPLAY_MIN_SIMILARITY=50.0

# Celery — jumlah worker process (produksi saat ini pakai 24)
CELERY_CONCURRENCY=8

# API Authentication
API_KEY=changeme-generate-random-string-here

# JWT Authentication
JWT_SECRET_KEY=changeme-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin seed user (dipakai migrasi Alembic 0001)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-admin-password
ADMIN_EMAIL=admin@bank.local

# Password default untuk scripts/seed_cashline_users.py (opsional).
# Kalau tidak diisi, script pakai default internalnya.
SEED_PASSWORD=

# Registry & tag image (dipakai docker-compose; Jenkins mengisinya sendiri)
REGISTRY=local
TAG=latest
