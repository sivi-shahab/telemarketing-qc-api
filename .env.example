# Salin ke .env lalu isi. File .env TIDAK boleh masuk git — di Jenkins,
# distribusikan lewat Credentials (secret file) atau taruh permanen di server.

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bankqc
POSTGRES_USER=bankqc
POSTGRES_PASSWORD=changeme

# Redis (port 6378 — sama dengan `redis-server --port 6378` di docker-compose)
REDIS_URL=redis://redis:6378/0

# MinIO
MINIO_ENDPOINT=minio:4003
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme123
MINIO_BUCKET_TRANSCRIPTS=transcripts
MINIO_BUCKET_RESULTS=results
MINIO_BUCKET_CAMPAIGNS=campaigns
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_AUDIO=audio
MINIO_BUCKET_SALES_DATABASE=sales-database
# MINIO_BUCKET_QC_DATABASE=qc-database

# Deployment lewat CDN: endpoint https + kredensial per-bucket (menggantikan
# MINIO_ACCESS_KEY/MINIO_SECRET_KEY global di atas — comment yang global kalau
# blok ini dipakai). Selama semua kosong, aplikasi tetap memakai key global.
# MINIO_ENDPOINT=cdn.bankmega.local
# MINIO_SECURE=true
# MINIO_ACCESS_KEY_TRANSCRIPTS=
# MINIO_SECRET_KEY_TRANSCRIPTS=
# MINIO_ACCESS_KEY_RESULTS=
# MINIO_SECRET_KEY_RESULTS=
# MINIO_ACCESS_KEY_CAMPAIGNS=
# MINIO_SECRET_KEY_CAMPAIGNS=
# MINIO_ACCESS_KEY_DOCUMENTS=
# MINIO_SECRET_KEY_DOCUMENTS=
# MINIO_ACCESS_KEY_AUDIO=
# MINIO_SECRET_KEY_AUDIO=
# MINIO_ACCESS_KEY_SALES_DATABASE=
# MINIO_SECRET_KEY_SALES_DATABASE=
# MINIO_ACCESS_KEY_QC_DATABASE=
# MINIO_SECRET_KEY_QC_DATABASE=
# Webhook ingestion (/webhook/process_ticket): where the upstream phase-1 caller
# drops the raw session PDFs inside the buckets above. "" = scan the whole bucket.
# Objects already under a {result_id} (UUID) folder are skipped.
MINIO_TRANSCRIPTS_SOURCE_PREFIX=inbox/
MINIO_DOCUMENTS_SOURCE_PREFIX=inbox/

# Aplikasi A (DWH) — sumber reference data CASHLINE + CARD HOLDER
# (services/data_dwh.py). Dari DALAM container pakai host.docker.internal:
# "localhost" menunjuk ke container ini sendiri, bukan ke Aplikasi A.
#   Docker     : http://host.docker.internal:8002
#   Bare-metal : http://localhost:8002
DWH_API_BASE_URL=http://host.docker.internal:8002
DWH_API_TIMEOUT_SEC=10
# TTL cache in-memory App B per result_id. HARUS lebih besar dari durasi satu
# request agregat (dan dari interval auto-refresh 30 detik halaman Statistik),
# kalau tidak entry-nya kedaluwarsa di tengah loop dan cid yang sama ditembak
# ulang. Ongkosnya: perubahan data DWH baru terlihat setelah maksimal segini.
DWH_API_CACHE_TTL_SEC=300

# Aplikasi C (recording_tms_api) — sumber baris /tickets-daily untuk halaman
# Recording Tickets & Assign Ticket. Dashboard TIDAK lagi memanggilnya langsung:
# permintaannya lewat App B (GET /tickets_daily) supaya ikut sesi login dan
# tersaring pembatasan campaign, sekaligus agar X-API-Key tidak ter-inline ke
# bundle JS. Sejak 28 Agustus 2026 stream PDF transkrip pun ikut lewat App B
# (GET /tickets_daily_pdf/{tiket_id}, lihat VIEW_STREAM_* di bawah), jadi
# VITE_TMS_API_URL/VITE_TMS_API_KEY sudah TIDAK dipakai dashboard sama sekali dan
# tidak boleh dihidupkan lagi: nilainya ikut ter-inline ke bundle yang dikirim ke
# browser.
# Dari DALAM container, "call-qc.bankmega.local" TIDAK bisa dipakai: nama itu
# menunjuk 127.0.0.1 di host (nginx yang mem-proxy App C), sedangkan 127.0.0.1 di
# dalam container adalah container itu sendiri -> Connection refused. Sama seperti
# DWH_API_BASE_URL di atas, pakai host.docker.internal + port App C.
#   Docker     : http://host.docker.internal:8008
#   Bare-metal : https://call-qc.bankmega.local
TMS_API_BASE_URL=http://host.docker.internal:8008
TMS_API_KEY=
TMS_API_TIMEOUT_SEC=30
# "false" bila App C memakai sertifikat internal yang tidak dipercaya container.
TMS_API_VERIFY_SSL=true
# TTL cache in-memory per kombinasi filter. Pendek: tiket baru harus cepat terlihat.
TMS_API_CACHE_TTL_SEC=60

# Aplikasi C bagian stream PDF transkrip (port 8010, TERPISAH dari :8008 di atas)
# — sumber berkas halaman detail transkrip. Sama seperti /tickets-daily,
# dashboard TIDAK memanggilnya langsung: permintaannya lewat App B
# (GET /tickets_daily_pdf/{tiket_id}) supaya ikut sesi login, tersaring pembatasan
# campaign, dan X-API-Key tidak ter-inline ke bundle JS.
# Berlaku catatan host yang sama: dari DALAM container, "call-qc.bankmega.local"
# menunjuk ke container itu sendiri -> Connection refused.
#   Docker     : http://host.docker.internal:8010
#   Bare-metal : https://call-qc.bankmega.local
VIEW_STREAM_BASE_URL=http://host.docker.internal:8010
# Kosong = ikut TMS_API_KEY di atas (App C yang sama).
VIEW_STREAM_API_KEY=
# Lebih longgar dari TMS_API_TIMEOUT_SEC: yang ditarik berkas PDF, bukan JSON.
VIEW_STREAM_TIMEOUT_SEC=60
VIEW_STREAM_VERIFY_SSL=true

# Pemetaan campaign App B -> field "context" App C, penyaring baris /tickets-daily.
# Format: Nama:context[|context2],Nama2:context3   (case-insensitive)
#
# Wajib ada karena kedua sistem memakai kosakata berbeda: App B menyimpan NAMA
# campaign (Cashline, Collection), App C mengirim KODE campaign (ACT02, CLENTB,
# LOC26, 011, MCS, MP01, NTB002) plus "context" (cashline/ntb/usage/card/
# alloblast/tbfu). Kode campaign TIDAK bisa dipakai sebagai kunci — pemetaannya ke
# context bukan 1:1 (MCS pernah muncul sebagai cashline, usage, alloblast maupun
# ntb).
#
# GAGAL TERTUTUP: campaign yang tidak disebut di sini tidak menyumbang context
# apa pun, sehingga login yang dibatasi ke campaign itu TIDAK MELIHAT SATU BARIS
# PUN di kedua halaman tersebut. Tambahkan entrinya begitu campaign baru dibuat.
#
# Catatan Collection: per 28 Agustus 2026 App C belum pernah mengirim baris
# collection sama sekali (sampel 6 tanggal: hanya cashline/ntb/usage/card/
# alloblast/tbfu). Nilai "collection" di bawah masih PENANDA — konfirmasikan ke
# pemilik App C lalu sesuaikan.
CAMPAIGN_CONTEXT_MAP=Cashline:cashline,Collection:collection

# LLM — endpoint OpenAI-compatible.
#   - self-hosted       : http://host.docker.internal:11444/v1  (model: gpt-oss-120b)
#   - Azure AI Foundry  : https://<your-foundry>.services.ai.azure.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=1800
LLM_TEMPERATURE=1.0
LLM_SEED=42
LLM_REASONING_EFFORT=medium

# RIPLAY extraction saat upload campaign (compliance/riplay.py).
# PDF dirender jadi image lalu dikirim ke model vision.
# RIPLAY_MODEL kosong = ikut LLM_MODEL.
# RIPLAY_MIN_SIMILARITY = ambang kemiripan nama produk di RIPLAY vs nama campaign.
RIPLAY_MODEL=
RIPLAY_MAX_PAGES=20
RIPLAY_RENDER_SCALE=2.0
RIPLAY_MIN_SIMILARITY=50.0

# Celery — jumlah worker process (produksi saat ini pakai 24)
CELERY_CONCURRENCY=8

# API Authentication
API_KEY=changeme-generate-random-string-here

# JWT Authentication
JWT_SECRET_KEY=changeme-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin seed user (dipakai migrasi Alembic 0001)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-admin-password
ADMIN_EMAIL=admin@bank.local

# Password default untuk scripts/seed_cashline_users.py (opsional).
# Kalau tidak diisi, script pakai default internalnya.
SEED_PASSWORD=

# Registry & tag image (dipakai docker-compose; Jenkins mengisinya sendiri)
REGISTRY=local
TAG=latest

# ============================================
# QC Collection
# ============================================
# Nama campaign penagihan (POJK 22/2023), dipisah koma. Kosong = tidak ada
# penyesuaian sama sekali dan perilaku lama utuh.
#
# Menggerakkan COLLECTION_REMOVED_PERMISSIONS / COLLECTION_ADDED_PERMISSIONS di
# api/permissions.py: login yang dibatasi HANYA ke campaign di daftar ini
# kehilangan Assign Ticket / Manual Check / Pending Check dan sebagai gantinya
# mendapat Upload Audio & Upload Transcript. Login Cashline dengan role yang
# sama tidak terpengaruh.
COLLECTION_CAMPAIGNS=
