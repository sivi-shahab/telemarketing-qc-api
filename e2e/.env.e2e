# Lingkungan E2E — TERISOLASI. Tidak satu nilai pun menunjuk produksi.
POSTGRES_HOST=e2e-pg
POSTGRES_PORT=5432
POSTGRES_DB=qce2e
POSTGRES_USER=qce2e
POSTGRES_PASSWORD=qce2e-pass
# Skema yang sama dengan produksi, supaya jalur search_path & alembic ikut teruji.
POSTGRES_SCHEMA=dashboard

REDIS_URL=redis://e2e-redis:6379/0
CELERY_CONCURRENCY=2

MINIO_ENDPOINT=e2e-minio:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_TRANSCRIPTS=transcripts
MINIO_BUCKET_RESULTS=results
MINIO_BUCKET_CAMPAIGNS=campaigns
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_AUDIO=audio
MINIO_BUCKET_SALES_DATABASE=sales-database
MINIO_ACCESS_KEY_TRANSCRIPTS=minioadmin
MINIO_SECRET_KEY_TRANSCRIPTS=minioadmin123
MINIO_ACCESS_KEY_RESULTS=minioadmin
MINIO_SECRET_KEY_RESULTS=minioadmin123
MINIO_ACCESS_KEY_CAMPAIGNS=minioadmin
MINIO_SECRET_KEY_CAMPAIGNS=minioadmin123
MINIO_ACCESS_KEY_DOCUMENTS=minioadmin
MINIO_SECRET_KEY_DOCUMENTS=minioadmin123
MINIO_ACCESS_KEY_AUDIO=minioadmin
MINIO_SECRET_KEY_AUDIO=minioadmin123
MINIO_ACCESS_KEY_SALES_DATABASE=minioadmin
MINIO_SECRET_KEY_SALES_DATABASE=minioadmin123

# LLM DISTUB — bukan endpoint Bank Mega. Lihat e2e/stub_llm/app.py.
LLM_BASE_URL=http://e2e-stub-llm:9099
LLM_API_KEY=stub
LLM_MODEL=stub-model
LLM_TEMPERATURE=1.0
LLM_TIMEOUT=60
LLM_REASONING_EFFORT=
RIPLAY_MODEL=

API_KEY=e2e-api-key
JWT_SECRET_KEY=e2e-jwt-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@e2e.local
AUDIO_RECORDING_DIR=/tmp/recording
DWH_API_BASE_URL=http://e2e-stub-llm:9099
